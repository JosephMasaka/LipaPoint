generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PendingSignup {
  id              String           @id @default(cuid())
  businessName    String
  businessType    TenantType
  tier            SubscriptionTier
  ownerName       String
  email           String
  phone           String
  passwordHash    String
  slug            String
  amount          Float
  couponCode      String?
  resellerCode    String?
  status          String           @default("PENDING")
  failureReason   String?
  transactionId   String?
  completionToken String           @unique
  tenantId        String?
  userId          String?
  createdAt       DateTime         @default(now())
  expiresAt       DateTime

  @@index([email])
  @@index([transactionId])
}

model Tenant {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  type             TenantType
  tier             SubscriptionTier       @default(STARTER)
  email            String
  phone            String?
  logo             String?
  address          String?
  city             String?
  country          String                 @default("KE")
  county           String?
  currency         String                 @default("KES")
  taxRate          Float                  @default(16.0)
  receiptHeader    String?
  receiptFooter    String?                @default("Thank you for shopping with us!")
  paystackSubCode  String?
  isActive         Boolean                @default(true)
  trialEndsAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  mpesaAccountName String?
  mpesaPaybill     String?
  mpesaTill        String?
  resellerId       String?
  reseller         Reseller?       @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  activityLogs     ActivityLog[]
  appointments     Appointment[]
  categories       Category[]
  customers        Customer[]
  dailySummaries   DailySummary[]
  deliveryZones    DeliveryZone[]
  discounts        Discount[]
  expenses         Expense[]
  locations        Location[]
  orders           Order[]
  products         Product[]
  queueEntries     QueueEntry[]
  rolePermissions  RolePermission[]
  services         Service[]
  staffSchedules   StaffSchedule[]
  stockMovements   StockMovement[]
  stockRecords     StockRecord[]
  tables           Table[]
  paymentGateways  TenantPaymentGateway[]
  transactions     Transaction[]
  unitsOfMeasure   UnitOfMeasure[]
  users            User[]
  tenantModules    TenantModule[]
  chartOfAccounts  ChartOfAccount[]
  journalEntries   JournalEntry[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  grns             GoodsReceivedNote[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]
  etimsInvoices    EtimsInvoice[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  phone          String?
  password       String
  role           UserRole        @default(CASHIER)
  avatar         String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activityLogs   ActivityLog[]
  assignedAppts  Appointment[]
  dailySummaries DailySummary[]
  expenses       Expense[]
  orders         Order[]
  passwordResets PasswordReset[]
  assignedQueue  QueueEntry[]
  sessions       Session[]
  staffSchedules StaffSchedule[]
  stockMovements StockMovement[]
  transactions   Transaction[]
  journalEntries JournalEntry[] @relation("JournalPostedBy")
  poCreated      PurchaseOrder[] @relation("POCreatedBy")
  grnsReceived   GoodsReceivedNote[] @relation("GRNReceivedBy")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Session {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String?
  resellerId String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reseller   Reseller? @relation(fields: [resellerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([resellerId])
}

model Reseller {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  phone             String?
  password          String
  code              String    @unique
  commissionPercent Float     @default(10.0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenants           Tenant[]
  sessions          Session[]

  @@index([code])
}

model Coupon {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String?
  type        CouponType
  value       Float
  maxUses     Int?
  usedCount   Int                 @default(0)
  isActive    Boolean             @default(true)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  redemptions CouponRedemption[]

  @@index([isActive])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  tenantId   String
  context    String
  amount     Float
  discount   Float
  paidAmount Float
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([tenantId])
}

model Location {
  id             String          @id @default(cuid())
  name           String
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  dailySummaries DailySummary[]
  expenses       Expense[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  registers      Register[]
  stocks         Stock[]
  stockMovements StockMovement[]
  stockRecords   StockRecord[]
  tables          Table[]
  journalEntries  JournalEntry[]
  purchaseOrders  PurchaseOrder[]
  grns            GoodsReceivedNote[]

  @@index([tenantId])
}

model Register {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  locationId String
  orders     Order[]
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  color    String     @default("#6366f1")
  icon     String?
  parentId String?
  tenantId String
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
}

model UnitOfMeasure {
  id              String           @id @default(cuid())
  name            String
  abbreviation    String
  tenantId        String
  products        Product[]        @relation("ProductBaseUnit")
  productUoms     ProductUoM[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UnitConversion {
  id         String        @id @default(cuid())
  fromUnitId String
  toUnitId   String
  factor     Float
  fromUnit   UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit     UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String
  barcode        String?
  description    String?
  image          String?
  price          Float
  cost           Float           @default(0)
  isActive       Boolean         @default(true)
  trackStock     Boolean         @default(true)
  lowStockAlert  Int             @default(10)
  baseUnitId     String
  tenantId       String
  categoryId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  baseUnit       UnitOfMeasure   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productUoms    ProductUoM[]
  stocks         Stock[]
  stockMovements StockMovement[]
  stockRecords   StockRecord[]
  purchaseOrderItems PurchaseOrderItem[]
  grnItems       GoodsReceivedNoteItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
  @@index([baseUnitId])
}

model ProductUoM {
  id               String        @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Float
  price            Float
  cost             Float         @default(0)
  barcode          String?
  isDefault        Boolean       @default(false)
  isActive         Boolean       @default(true)
  orderItems       OrderItem[]
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([barcode])
}

model Stock {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  productId  String
  locationId String
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model StockMovement {
  id         String            @id @default(cuid())
  type       StockMovementType
  quantity   Int
  productId  String
  locationId String
  reference  String?
  notes      String?
  tenantId   String
  userId     String?
  createdAt  DateTime          @default(now())
  location   Location          @relation(fields: [locationId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
  @@index([type])
}

model Order {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  status          OrderStatus   @default(PENDING)
  tabName         String?
  subtotal        Float
  taxAmount       Float
  discount        Float         @default(0)
  total           Float
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentRef      String?
  notes           String?
  customerName    String?
  customerPhone   String?
  tenantId        String
  locationId      String
  registerId      String?
  userId          String
  tableId         String?
  customerId      String?
  deliveryAddress String?
  deliveryPhone   String?
  deliveryFee     Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer?     @relation(fields: [customerId], references: [id])
  location        Location      @relation(fields: [locationId], references: [id])
  register        Register?     @relation(fields: [registerId], references: [id])
  table           Table?        @relation(fields: [tableId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  transactions    Transaction[]

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
  @@index([createdAt])
  @@index([orderNo])
  @@index([status])
  @@index([tableId])
}

model OrderItem {
  id            String            @id @default(cuid())
  quantity      Int
  unitPrice     Float
  total         Float
  baseQuantity  Int
  note          String?
  kitchenStatus KitchenItemStatus @default(PENDING)
  productId     String
  productUomId  String?
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  productUom    ProductUoM?       @relation(fields: [productUomId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productUomId])
}

model TenantPaymentGateway {
  id             String          @id @default(cuid())
  tenantId       String
  provider       PaymentProvider
  isActive       Boolean         @default(false)
  apiKeyEnc      String?
  apiSecretEnc   String?
  merchantRef    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  credentialsEnc String?
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model Transaction {
  id              String           @id @default(cuid())
  type            String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus    @default(PENDING)
  reference       String?          @unique
  gatewayRef      String?
  gatewayStatus   String?
  mpesaPhone      String?
  cardLast4       String?
  description     String?
  couponCode      String?
  tenantId        String
  orderId         String?
  userId          String?
  createdAt       DateTime         @default(now())
  enteredManually Boolean          @default(false)
  provider        PaymentProvider?
  order           Order?           @relation(fields: [orderId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@index([orderId])
  @@index([createdAt])
  @@index([method])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  module    String?  // pos | finance | procurement | payroll | ... (inferred from action prefix unless set)
  entity    String
  entityId  String?
  details   String?
  before    Json?
  after     Json?
  tenantId  String
  userId    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

// ═════════════════════════════════════════════════════════════════════
// ERP Phase 0 — Foundation
// Per-module entitlement gating + the Finance general-ledger skeleton that
// every other module (POS sales, payroll, depreciation, procurement) posts
// through. See lipapoint-erp-spec.md §3/§8.
// ═════════════════════════════════════════════════════════════════════

model TenantModule {
  id         String    @id @default(cuid())
  tenantId   String
  moduleKey  String    // "pos" | "inventory" | "finance" | "payroll" | "assets" | "procurement" | "crm" | "etims"
  enabled    Boolean   @default(false)
  planTier   String    // SubscriptionTier the entitlement was granted at ("ADDON" for paid add-ons)
  source     String    @default("tier") // tier (re-synced on tier change) | addon | manual (both survive re-syncs)
  enabledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
}

model ChartOfAccount {
  id             String            @id @default(cuid())
  tenantId       String
  code           String            // e.g. "4000"
  name           String
  type           String            // asset | liability | equity | income | expense
  parentId       String?
  isSystem       Boolean           @default(false) // seeded accounts, non-deletable
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent         ChartOfAccount?   @relation("COATree", fields: [parentId], references: [id])
  children       ChartOfAccount[]  @relation("COATree")
  journalLines   JournalLine[]
  bankAccounts   BankAccount[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([type])
}

model JournalEntry {
  id             String        @id @default(cuid())
  tenantId       String
  locationId     String?
  date           DateTime
  reference      String        // e.g. SALE-0001, PAY-0003, PO-0002
  sourceModule   String        // pos | payroll | procurement | manual | ...
  sourceId       String?
  description    String?
  // Nullable: system jobs (depreciation runs, payroll filing) post without a user.
  postedBy       String?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location?     @relation(fields: [locationId], references: [id])
  postedByUser   User?         @relation("JournalPostedBy", fields: [postedBy], references: [id])
  lines          JournalLine[]

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([sourceModule, sourceId])
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  creditNotes      CreditNote[]
  debitNotes       DebitNote[]
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  accountId      String
  // Decimal, not Float: a trial balance must sum to exactly zero and
  // float drift breaks that. Source amounts from Float columns are
  // rounded to cents before posting (see src/lib/journal.ts).
  debit          Decimal       @default(0)
  credit         Decimal       @default(0)
  description    String?
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  matchedBankTransactions BankTransaction[]

  @@index([journalEntryId])
  @@index([accountId])
}

// ═══════════════════════════════════════════════════════════════════
// ERP Phase 1 — Finance (bank/cash, credit/debit notes) + Procurement
// (supplier, PO → GRN → invoice → payment). See lipapoint-erp-spec.md §4.3/§4.6.
// ═══════════════════════════════════════════════════════════════════

model BankAccount {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  type           String   // bank | mpesa_till | mpesa_paybill | cash
  accountNumber  String?
  openingBalance Float    @default(0)
  // GL account this bank/cash wallet posts into (defaults by type:
  // cash→1010, mpesa_till→1020, mpesa_paybill→1030, bank→1040).
  coaAccountId   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coaAccount     ChartOfAccount? @relation(fields: [coaAccountId], references: [id])
  transactions   BankTransaction[]
  supplierPayments SupplierPayment[]

  @@index([tenantId])
}

model BankTransaction {
  id             String   @id @default(cuid())
  tenantId       String
  bankAccountId  String
  date           DateTime
  amount         Float
  direction      String   // in | out
  description    String?
  reference      String?
  reconciled     Boolean  @default(false)
  reconciledAt   DateTime?
  matchedJournalLineId String?
  createdAt      DateTime @default(now())
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matchedJournalLine JournalLine? @relation(fields: [matchedJournalLineId], references: [id])

  @@index([tenantId])
  @@index([bankAccountId])
  @@index([reconciled])
}

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  kraPin         String?
  email          String?
  phone          String?
  address        String?
  paymentTerms   String?  // e.g. "Net 30"
  balance        Float    @default(0) // amount owed to supplier
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  debitNotes     DebitNote[]

  @@index([tenantId])
  @@index([name])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  tenantId       String
  supplierId     String
  poNumber       String
  status         String   @default("draft") // draft | sent | partially_received | received | closed | cancelled
  locationId     String?
  expectedDate   DateTime?
  subtotal       Float    @default(0)
  total          Float    @default(0)
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  location       Location? @relation(fields: [locationId], references: [id])
  createdByUser  User?    @relation("POCreatedBy", fields: [createdBy], references: [id])
  items          PurchaseOrderItem[]
  grns           GoodsReceivedNote[]
  invoices       SupplierInvoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([status])
}

model PurchaseOrderItem {
  id             String   @id @default(cuid())
  purchaseOrderId String
  productId      String?
  description    String
  quantity       Int
  unitCost       Float
  // Running total of quantities already received across all GRNs — the
  // source of partially_received vs received, not a trust-the-PO flag.
  receivedQty    Int      @default(0)
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id])
  grnItems       GoodsReceivedNoteItem[]

  @@index([purchaseOrderId])
}

model GoodsReceivedNote {
  id             String   @id @default(cuid())
  tenantId       String
  purchaseOrderId String
  grnNumber      String
  receivedDate   DateTime
  locationId     String?
  receivedBy     String?
  notes          String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  location       Location? @relation(fields: [locationId], references: [id])
  receivedByUser User?    @relation("GRNReceivedBy", fields: [receivedBy], references: [id])
  items          GoodsReceivedNoteItem[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId])
}

model GoodsReceivedNoteItem {
  id             String   @id @default(cuid())
  grnId          String
  poItemId       String?
  productId      String?
  description    String
  quantity       Int
  unitCost       Float
  grn            GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem         PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  product        Product? @relation(fields: [productId], references: [id])

  @@index([grnId])
}

model SupplierInvoice {
  id             String   @id @default(cuid())
  tenantId       String
  supplierId     String
  poId           String?
  invoiceNumber  String
  amount         Float
  paidAmount     Float    @default(0)
  dueDate        DateTime?
  status         String   @default("unpaid") // unpaid | partial | paid
  etimsValidated Boolean  @default(false)
  journalEntryId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrder  PurchaseOrder? @relation(fields: [poId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  payments       SupplierPayment[]
  debitNotes     DebitNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([status])
}

model SupplierPayment {
  id             String   @id @default(cuid())
  tenantId       String
  supplierId     String
  invoiceId      String?
  bankAccountId  String?
  amount         Float
  method         String   // cash | mpesa | bank | cheque
  reference      String?
  paidAt         DateTime
  journalEntryId String?
  createdBy      String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([tenantId])
  @@index([supplierId])
  @@index([invoiceId])
}

model CreditNote {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String
  creditNoteNumber String
  amount         Float
  reason         String
  status         String   @default("draft") // draft | approved | void
  journalEntryId String?
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer @relation(fields: [customerId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([tenantId, creditNoteNumber])
  @@index([tenantId])
  @@index([status])
}

model DebitNote {
  id             String   @id @default(cuid())
  tenantId       String
  supplierId     String
  invoiceId      String?
  debitNoteNumber String
  amount         Float
  reason         String
  status         String   @default("draft") // draft | approved | void
  journalEntryId String?
  createdBy      String?
  approvedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  invoice        SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([tenantId, debitNoteNumber])
  @@index([tenantId])
  @@index([status])
}

// eTIMS / KRA OSCU invoice submissions (LipaPoint ERP spec §4.8).
// One row per source document (sale | credit_note | supplier_invoice),
// unique per tenant so re-hooks and retries can never double-submit.
model EtimsInvoice {
  id                 String    @id @default(cuid())
  tenantId           String
  sourceType         String    // sale | credit_note | supplier_invoice
  sourceId           String
  sourceRef          String?   // orderNo / creditNoteNumber / invoiceNumber
  status             String    @default("pending") // pending | submitted | accepted | rejected
  totalAmount        Float     @default(0)
  taxAmount          Float     @default(0)
  kraInvoiceNumber   String?
  qrCodeUrl          String?
  attempts           Int       @default(0)
  lastError          String?
  submittedAt        DateTime?
  rawResponse        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model StockRecord {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  openingStock Int
  addedStock   Int      @default(0)
  soldStock    Int      @default(0)
  closingStock Int
  adjustment   Int      @default(0)
  variance     Int      @default(0)
  notes        String?
  productId    String
  locationId   String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([productId])
  @@index([locationId])
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  category    String
  description String
  amount      Float
  receiptNo   String?
  supplier    String?
  isRecurring Boolean   @default(false)
  tenantId    String
  locationId  String?
  userId      String?
  createdAt   DateTime  @default(now())
  location    Location? @relation(fields: [locationId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([category])
  @@index([locationId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model RolePermission {
  id          String   @id @default(cuid())
  role        String
  permissions String[]
  description String?
  isSystem    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
  @@index([tenantId])
}

model DailySummary {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  cashBroughtForward Float    @default(0)
  totalSales         Float    @default(0)
  debtsPaid          Float    @default(0)
  otherIncome        Float    @default(0)
  subtotal           Float    @default(0)
  mpesaReceived      Float    @default(0)
  purchases          Float    @default(0)
  expenses           Float    @default(0)
  unpaidBills        Float    @default(0)
  totalCash          Float    @default(0)
  cashSurrendered    Float    @default(0)
  shortExcess        Float    @default(0)
  cashCarriedForward Float    @default(0)
  notes              String?
  tenantId           String
  locationId         String
  userId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  location           Location @relation(fields: [locationId], references: [id])
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([locationId])
}

model DemoRequest {
  id           String            @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  businessType TenantType
  message      String?
  status       DemoRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@index([status])
}

model Subscription {
  id               String           @id @default(cuid())
  tenantId         String
  tier             SubscriptionTier
  paystackPlanCode String?
  paystackSubCode  String?
  paystackCustCode String?
  amount           Float
  currency         String           @default("KES")
  status           String           @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  notes         String?
  totalSpent    Float     @default(0)
  visitCount    Int       @default(0)
  lastVisit     DateTime?
  loyaltyPoints Int       @default(0)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  creditNotes   CreditNote[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Discount {
  id        String    @id @default(cuid())
  name      String
  code      String?
  type      String
  value     Float
  minOrder  Float?
  maxUses   Int?
  usedCount Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Table {
  id         String      @id @default(cuid())
  name       String
  capacity   Int         @default(4)
  status     TableStatus @default(AVAILABLE)
  locationId String
  tenantId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orders     Order[]
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([locationId])
  @@index([status])
}

model DeliveryZone {
  id            String   @id @default(cuid())
  name          String
  minOrder      Float    @default(0)
  deliveryFee   Float    @default(0)

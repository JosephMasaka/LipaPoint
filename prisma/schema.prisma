  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Float
  duration     Int           @default(30)
  isActive     Boolean       @default(true)
  categoryId   String?
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  category     Category?     @relation(fields: [categoryId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
}

model Appointment {
  id          String            @id @default(cuid())
  date        DateTime          @db.Date
  startTime   String
  endTime     String
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  clientName  String
  clientPhone String?
  serviceId   String
  staffId     String?
  tenantId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  service     Service           @relation(fields: [serviceId], references: [id])
  staff       User?             @relation(fields: [staffId], references: [id])
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@index([staffId])
  @@index([status])
}

model QueueEntry {
  id          String      @id @default(cuid())
  ticketNo    Int
  clientName  String
  clientPhone String?
  serviceName String?
  status      QueueStatus @default(WAITING)
  staffId     String?
  tenantId    String
  createdAt   DateTime    @default(now())
  servedAt    DateTime?
  completedAt DateTime?
  staff       User?       @relation(fields: [staffId], references: [id])
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model StaffSchedule {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  isOff     Boolean  @default(false)
  notes     String?
  staffId   String
  tenantId  String
  createdAt DateTime @default(now())
  staff     User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([tenantId])
  @@index([date])
  @@index([staffId])
}


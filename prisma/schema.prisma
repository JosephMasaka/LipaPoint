datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantType {
  RETAIL
  RESTAURANT
  BAR
  SUPERMARKET
  PHARMACY
  HARDWARE
}

enum OrderStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED
  REFUNDED
  TAB
}

enum PaymentMethod {
  CASH
  MPESA_MANUAL   // was MPESA — till/paybill on the wall, code entered by cashier
  MPESA_STK      // aggregator or Daraja push to customer's phone
  CARD
  PDQ
  PAYSTACK
}

enum PaymentProvider {
  DARAJA
  INTASEND
  PESAPAL
  KOPOKOPO
  FLUTTERWAVE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STOCK_KEEPER
  KITCHEN
}

enum DemoRequestStatus {
  PENDING
  CONTACTED
  CONVERTED
  DECLINED
}

enum StockMovementType {
  GOODS_RECEIPT
  GOODS_ISSUE
  TRANSFER
  ADJUSTMENT
  SALE_RETURN
  OPENING_BALANCE
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model Tenant {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            TenantType
  tier            SubscriptionTier @default(STARTER)
  email           String
  phone           String?
  logo            String?
  address         String?
  city            String?
  country         String           @default("KE")
  currency        String           @default("KES")
  taxRate         Float            @default(16.0)
  receiptHeader   String?
  receiptFooter   String?          @default("Thank you for shopping with us!")
  paystackSubCode String?
  isActive        Boolean          @default(true)
  trialEndsAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  users          User[]
  locations      Location[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  transactions   Transaction[]
  activityLogs   ActivityLog[]
  unitsOfMeasure UnitOfMeasure[]
  stockRecords   StockRecord[]
  stockMovements StockMovement[]
  expenses        Expense[]
  dailySummaries  DailySummary[]
  rolePermissions RolePermission[]

  mpesaPaybill     String?
  mpesaTill        String?
  mpesaAccountName String?

  paymentGateways  TenantPaymentGateway[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  password  String
  role      UserRole @default(CASHIER)
  avatar    String?
  isActive  Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  activityLogs   ActivityLog[]
  sessions       Session[]
  expenses       Expense[]
  transactions   Transaction[]
  stockMovements StockMovement[]
  dailySummaries DailySummary[]
  passwordResets PasswordReset[]

  @@index([tenantId])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Location {
  id             String          @id @default(cuid())
  name           String
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registers      Register[]
  stocks         Stock[]
  orders         Order[]
  stockRecords   StockRecord[]
  stockMovements StockMovement[]
  expenses       Expense[]
  dailySummaries DailySummary[]
  createdAt      DateTime        @default(now())

  @@index([tenantId])
}

model Register {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([locationId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  color    String     @default("#6366f1")
  icon     String?
  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
}

model UnitOfMeasure {
  id              String           @id @default(cuid())
  name            String
  abbreviation    String
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products        Product[]        @relation("ProductBaseUnit")
  productUoms     ProductUoM[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UnitConversion {
  id         String        @id @default(cuid())
  fromUnitId String
  fromUnit   UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnitId   String
  toUnit     UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)
  factor     Float

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
}

// ─── SAP MATERIAL MASTER (MARA) ─────────────────────────────────────────────

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String
  barcode        String?
  description    String?
  image          String?
  price          Float // base UoM selling price
  cost           Float           @default(0) // base UoM cost price
  isActive       Boolean         @default(true)
  trackStock     Boolean         @default(true)
  lowStockAlert  Int             @default(10)
  baseUnitId     String // SAP MEINS - base unit of measure for stock tracking
  baseUnit       UnitOfMeasure   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks         Stock[]
  orderItems     OrderItem[]
  stockRecords   StockRecord[]
  stockMovements StockMovement[]
  productUoms    ProductUoM[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
  @@index([baseUnitId])
}

// ─── SAP MARM - Product Unit of Measure (Dimensions of Pay) ─────────────────

model ProductUoM {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId           String
  unit             UnitOfMeasure @relation(fields: [unitId], references: [id])
  conversionFactor Float // how many base units in this UoM (e.g., crate=24, dozen=12)
  price            Float // selling price in this UoM
  cost             Float         @default(0) // cost price in this UoM
  barcode          String? // barcode specific to this UoM packaging
  isDefault        Boolean       @default(false) // default selling UoM in POS
  isActive         Boolean       @default(true)

  orderItems OrderItem[]

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([barcode])
}

model Stock {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

// ─── SAP MSEG - Stock Movement Document ─────────────────────────────────────

model StockMovement {
  id         String            @id @default(cuid())
  type       StockMovementType
  quantity   Int
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  reference  String? // order number, PO number, etc.
  notes      String?
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?             @relation(fields: [userId], references: [id])
  createdAt  DateTime          @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
  @@index([type])
}

model Order {
  id            String        @id @default(cuid())
  orderNo       String        @unique
  status        OrderStatus   @default(PENDING)
  tabName       String?
  subtotal      Float
  taxAmount     Float
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?
  notes         String?
  customerName  String?
  customerPhone String?
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id])
  registerId    String?
  register      Register?     @relation(fields: [registerId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
  @@index([createdAt])
  @@index([orderNo])
  @@index([status])
}

model OrderItem {
  id           String      @id @default(cuid())
  quantity     Int // quantity in selected UoM
  unitPrice    Float // price per selected UoM
  total        Float
  baseQuantity Int // quantity converted to base UoM (for stock deduction)
  note         String?
  productId    String
  product      Product     @relation(fields: [productId], references: [id])
  productUomId String?
  productUom   ProductUoM? @relation(fields: [productUomId], references: [id])
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([productUomId])
}

model TenantPaymentGateway {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     PaymentProvider
  isActive     Boolean         @default(false)
  apiKeyEnc    String?         // AES-256-GCM encrypted, decrypted only server-side
  apiSecretEnc String?
  merchantRef  String?         // sub-merchant/shortcode at the aggregator
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model Transaction {
  id            String        @id @default(cuid())
  type          String // SALE, REFUND, PAYMENT
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?       @unique
  gatewayRef    String? // Paystack/M-Pesa reference
  gatewayStatus String? // gateway-specific status
  enteredManually Boolean @default(false)
  mpesaPhone    String? // for M-Pesa STK push
  cardLast4     String? // last 4 digits for card/PDQ
  description   String?
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId])
  @@index([reference])
  @@index([orderId])
  @@index([createdAt])
  @@index([method])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ─── SAP Daily Stock Ledger ─────────────────────────────────────────────────
// Closing stock = opening + added - sold + adjustment
// Next day's opening = previous day's closing

model StockRecord {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  openingStock Int // carried from previous day's closingStock
  addedStock   Int      @default(0) // goods received today
  soldStock    Int      @default(0) // sold today (from completed orders)
  closingStock Int // = openingStock + addedStock - soldStock + adjustment
  adjustment   Int      @default(0) // manual adjustments (breakage, theft, etc.)
  variance     Int      @default(0) // closingStock - (openingStock + addedStock - soldStock + adjustment)
  notes        String?
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([productId])
  @@index([locationId])
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  category    String
  description String
  amount      Float
  receiptNo   String?
  supplier    String?
  isRecurring Boolean   @default(false)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([date])
  @@index([category])
  @@index([locationId])
}

// ─── Password Reset ─────────────────────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ─── Role Permissions (Per-Tenant Customizable RBAC) ────────────────────────

model RolePermission {
  id          String   @id @default(cuid())
  role        String // matches UserRole enum value or custom role name
  permissions String[] // array of permission keys (e.g., ["pos", "orders", "tabs"])
  description String?  // custom description for the role
  isSystem    Boolean  @default(true) // system roles can't be deleted
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, role])
  @@index([tenantId])
}

// ─── Daily Cash Summary (Bar Stock Sheet Reconciliation) ────────────────────
// Matches the physical "SUMMARY" section on Club Chairman-style stock sheets

model DailySummary {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  cashBroughtForward Float    @default(0) // previous day's cashCarriedForward
  totalSales         Float    @default(0) // sum of completed cash orders
  debtsPaid          Float    @default(0) // tabs/debts collected today
  otherIncome        Float    @default(0) // miscellaneous income
  subtotal           Float    @default(0) // cashBroughtForward + totalSales + debtsPaid + otherIncome
  mpesaReceived      Float    @default(0) // M-Pesa payments (non-cash, deducted)
  purchases          Float    @default(0) // stock purchased today
  expenses           Float    @default(0) // operational expenses today
  unpaidBills        Float    @default(0) // credit given (tabs opened, not settled)
  totalCash          Float    @default(0) // subtotal - (mpesa + purchases + expenses + unpaidBills)
  cashSurrendered    Float    @default(0) // what cashier physically hands over
  shortExcess        Float    @default(0) // totalCash - cashSurrendered (negative=short, positive=excess)
  cashCarriedForward Float    @default(0) // carried to next day
  notes              String?
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId         String
  location           Location @relation(fields: [locationId], references: [id])
  userId             String? // cashier who closed the day
  user               User?    @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([locationId])
}

model DemoRequest {
  id           String            @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  businessType TenantType
  message      String?
  status       DemoRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@index([status])
}

model Subscription {
  id               String           @id @default(cuid())
  tenantId         String
  tier             SubscriptionTier
  paystackPlanCode String?
  paystackSubCode  String?
  paystackCustCode String?
  amount           Float
  currency         String           @default("KES")
  status           String           @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
}

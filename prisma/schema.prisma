generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  type             TenantType
  tier             SubscriptionTier       @default(STARTER)
  email            String
  phone            String?
  logo             String?
  address          String?
  city             String?
  country          String                 @default("KE")
  currency         String                 @default("KES")
  taxRate          Float                  @default(16.0)
  receiptHeader    String?
  receiptFooter    String?                @default("Thank you for shopping with us!")
  paystackSubCode  String?
  isActive         Boolean                @default(true)
  trialEndsAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  mpesaAccountName String?
  mpesaPaybill     String?
  mpesaTill        String?
  activityLogs     ActivityLog[]
  categories       Category[]
  dailySummaries   DailySummary[]
  expenses         Expense[]
  locations        Location[]
  orders           Order[]
  products         Product[]
  rolePermissions  RolePermission[]
  stockMovements   StockMovement[]
  stockRecords     StockRecord[]
  paymentGateways  TenantPaymentGateway[]
  transactions     Transaction[]
  unitsOfMeasure   UnitOfMeasure[]
  users            User[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String
  phone          String?
  password       String
  role           UserRole        @default(CASHIER)
  avatar         String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  activityLogs   ActivityLog[]
  dailySummaries DailySummary[]
  expenses       Expense[]
  orders         Order[]
  passwordResets PasswordReset[]
  sessions       Session[]
  stockMovements StockMovement[]
  transactions   Transaction[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Location {
  id             String          @id @default(cuid())
  name           String
  address        String?
  phone          String?
  isActive       Boolean         @default(true)
  tenantId       String
  createdAt      DateTime        @default(now())
  dailySummaries DailySummary[]
  expenses       Expense[]
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  registers      Register[]
  stocks         Stock[]
  stockMovements StockMovement[]
  stockRecords   StockRecord[]

  @@index([tenantId])
}

model Register {
  id         String   @id @default(cuid())
  name       String
  isActive   Boolean  @default(true)
  locationId String
  orders     Order[]
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  color    String     @default("#6366f1")
  icon     String?
  parentId String?
  tenantId String
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
}

model UnitOfMeasure {
  id              String           @id @default(cuid())
  name            String
  abbreviation    String
  tenantId        String
  products        Product[]        @relation("ProductBaseUnit")
  productUoms     ProductUoM[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UnitConversion {
  id         String        @id @default(cuid())
  fromUnitId String
  toUnitId   String
  factor     Float
  fromUnit   UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit     UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
}

model Product {
  id             String          @id @default(cuid())
  name           String
  sku            String
  barcode        String?
  description    String?
  image          String?
  price          Float
  cost           Float           @default(0)
  isActive       Boolean         @default(true)
  trackStock     Boolean         @default(true)
  lowStockAlert  Int             @default(10)
  baseUnitId     String
  tenantId       String
  categoryId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  baseUnit       UnitOfMeasure   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productUoms    ProductUoM[]
  stocks         Stock[]
  stockMovements StockMovement[]
  stockRecords   StockRecord[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
  @@index([baseUnitId])
}

model ProductUoM {
  id               String        @id @default(cuid())
  productId        String
  unitId           String
  conversionFactor Float
  price            Float
  cost             Float         @default(0)
  barcode          String?
  isDefault        Boolean       @default(false)
  isActive         Boolean       @default(true)
  orderItems       OrderItem[]
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit             UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId])
  @@index([productId])
  @@index([unitId])
  @@index([barcode])
}

model Stock {
  id         String   @id @default(cuid())
  quantity   Int      @default(0)
  productId  String
  locationId String
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([productId])
  @@index([locationId])
}

model StockMovement {
  id         String            @id @default(cuid())
  type       StockMovementType
  quantity   Int
  productId  String
  locationId String
  reference  String?
  notes      String?
  tenantId   String
  userId     String?
  createdAt  DateTime          @default(now())
  location   Location          @relation(fields: [locationId], references: [id])
  product    Product           @relation(fields: [productId], references: [id])
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([locationId])
  @@index([createdAt])
  @@index([type])
}

model Order {
  id            String        @id @default(cuid())
  orderNo       String        @unique
  status        OrderStatus   @default(PENDING)
  tabName       String?
  subtotal      Float
  taxAmount     Float
  discount      Float         @default(0)
  total         Float
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  paymentRef    String?
  notes         String?
  customerName  String?
  customerPhone String?
  tenantId      String
  locationId    String
  registerId    String?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  location      Location      @relation(fields: [locationId], references: [id])
  register      Register?     @relation(fields: [registerId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  transactions  Transaction[]

  @@index([tenantId])
  @@index([locationId])
  @@index([userId])
  @@index([createdAt])
  @@index([orderNo])
  @@index([status])
}

model OrderItem {
  id           String      @id @default(cuid())
  quantity     Int
  unitPrice    Float
  total        Float
  baseQuantity Int
  note         String?
  productId    String
  productUomId String?
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product     @relation(fields: [productId], references: [id])
  productUom   ProductUoM? @relation(fields: [productUomId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productUomId])
}

model TenantPaymentGateway {
  id           String          @id @default(cuid())
  tenantId     String
  provider     PaymentProvider
  isActive     Boolean         @default(false)
  apiKeyEnc    String?
  apiSecretEnc String?
  merchantRef  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model Transaction {
  id              String        @id @default(cuid())
  type            String
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  reference       String?       @unique
  gatewayRef      String?
  gatewayStatus   String?
  mpesaPhone      String?
  cardLast4       String?
  description     String?
  tenantId        String
  orderId         String?
  userId          String?
  createdAt       DateTime      @default(now())
  enteredManually Boolean       @default(false)
  order           Order?        @relation(fields: [orderId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([reference])
  @@index([orderId])
  @@index([createdAt])
  @@index([method])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  tenantId  String
  userId    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
}

model StockRecord {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  openingStock Int
  addedStock   Int      @default(0)
  soldStock    Int      @default(0)
  closingStock Int
  adjustment   Int      @default(0)
  variance     Int      @default(0)
  notes        String?
  productId    String
  locationId   String
  tenantId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([productId])
  @@index([locationId])
}

model Expense {
  id          String    @id @default(cuid())
  date        DateTime  @db.Date
  category    String
  description String
  amount      Float
  receiptNo   String?
  supplier    String?
  isRecurring Boolean   @default(false)
  tenantId    String
  locationId  String?
  userId      String?
  createdAt   DateTime  @default(now())
  location    Location? @relation(fields: [locationId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([date])
  @@index([category])
  @@index([locationId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model RolePermission {
  id          String   @id @default(cuid())
  role        String
  permissions String[]
  description String?
  isSystem    Boolean  @default(true)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role])
  @@index([tenantId])
}

model DailySummary {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  cashBroughtForward Float    @default(0)
  totalSales         Float    @default(0)
  debtsPaid          Float    @default(0)
  otherIncome        Float    @default(0)
  subtotal           Float    @default(0)
  mpesaReceived      Float    @default(0)
  purchases          Float    @default(0)
  expenses           Float    @default(0)
  unpaidBills        Float    @default(0)
  totalCash          Float    @default(0)
  cashSurrendered    Float    @default(0)
  shortExcess        Float    @default(0)
  cashCarriedForward Float    @default(0)
  notes              String?
  tenantId           String
  locationId         String
  userId             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  location           Location @relation(fields: [locationId], references: [id])
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id])

  @@unique([tenantId, locationId, date])
  @@index([tenantId])
  @@index([date])
  @@index([locationId])
}

model DemoRequest {
  id           String            @id @default(cuid())
  businessName String
  contactName  String
  email        String
  phone        String
  businessType TenantType
  message      String?
  status       DemoRequestStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  @@index([status])
}

model Subscription {
  id               String           @id @default(cuid())
  tenantId         String
  tier             SubscriptionTier
  paystackPlanCode String?
  paystackSubCode  String?
  paystackCustCode String?
  amount           Float
  currency         String           @default("KES")
  status           String           @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([tenantId])
}

enum SubscriptionTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantType {
  RETAIL
  RESTAURANT
  BAR
  SUPERMARKET
  PHARMACY
  HARDWARE
}

enum OrderStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED
  REFUNDED
  TAB
}

enum PaymentMethod {
  CASH
  MPESA_MANUAL
  MPESA_STK
  CARD
  PDQ
  PAYSTACK
}

enum PaymentProvider {
  DARAJA
  INTASEND
  PESAPAL
  KOPOKOPO
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  STOCK_KEEPER
  KITCHEN
}

enum DemoRequestStatus {
  PENDING
  CONTACTED
  CONVERTED
  DECLINED
}

enum StockMovementType {
  GOODS_RECEIPT
  GOODS_ISSUE
  TRANSFER
  ADJUSTMENT
  SALE_RETURN
  OPENING_BALANCE
}

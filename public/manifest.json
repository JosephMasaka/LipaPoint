{
  "name": "LipaPoint ERP",
  "short_name": "LipaPoint",
  "description": "Kenya's all-in-one ERP. Point of sale, M-Pesa payments, inventory, statutory payroll, accounting, fixed assets and KRA eTIMS for restaurants, bars, retail shops, supermarkets and pharmacies.",
  "id": "lipapoint-pos",
  "start_url": "/login?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "orientation": "any",
  "categories": ["business", "finance", "productivity"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/images/screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "LipaPoint ERP Dashboard — sales, operations and compliance at a glance"
    },
    {
      "src": "/images/screenshots/dashboard-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "LipaPoint ERP Mobile — today's sales and operations"
    }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Point of Sale",
      "short_name": "POS",
      "url": "/login?redirect=pos",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Orders",
      "short_name": "Orders",
      "url": "/login?redirect=orders",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}
